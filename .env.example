# Public site URL used for canonical tags, sitemap, and Open Graph.
# Local: http://localhost:3000
# Production: https://harvestbench.com
NEXT_PUBLIC_SITE_URL=https://harvestbench.com

# Google Analytics 4 measurement ID (optional). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher client ID (optional). Example: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional AdSense ad unit slot IDs. AdSlot renders nothing until these are set.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Contact email shown on /contact and used for mailto form submissions.
NEXT_PUBLIC_CONTACT_EMAIL=contact@harvestbench.com
